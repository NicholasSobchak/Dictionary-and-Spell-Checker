# QuickQuill frontend image (dedicated Dockerfile for Render).
#
# Self-contained build of the nginx image serving the built Angular app.
# Render Blueprints cannot select a stage of a multi-stage Dockerfile, so this
# file inlines only the frontend stages. The self-hosted stack keeps using the
# multi-stage `Dockerfile` + --target.
#
# Self-hosted stack: docker.conf is active (TLS at the container, certs bind
# mounted by compose.prod.yml).
# Render: render.conf is kept as an inert template. Render TLS-terminates at
# the edge, so the container serves plain HTTP:80; the blueprint's
# startCommand envsubst's this template (BACKEND_URL) into the active conf.

### Stage 1: Angular frontend build
FROM node:20-slim AS frontend-build
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

### Stage 2: nginx runtime image
FROM nginx:stable-alpine AS frontend
COPY nginx/docker.conf /etc/nginx/conf.d/default.conf
COPY nginx/render.conf /etc/nginx/conf.d/default.conf.template
COPY --from=frontend-build /web/dist/browser /usr/share/nginx/html

# Render start (no startCommand allowed on docker runtime): expand ONLY
# BACKEND_URL into the active conf (leaving nginx runtime vars like $host
# untouched), then run nginx in the foreground.
CMD ["sh", "-c", "envsubst '${BACKEND_URL}' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]

EXPOSE 80 443
# QuickQuill frontend image: nginx serving the built Angular app.
# Built and pushed by .github/workflows/deploy.yml, then pulled on the VPS.

### Angular build stage
FROM node:20-slim AS frontend
WORKDIR /web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

### Runtime image
FROM nginx:stable-alpine
COPY nginx/docker.conf /etc/nginx/conf.d/default.conf
COPY --from=frontend /web/dist/browser /usr/share/nginx/html

EXPOSE 80 443
